# Obligatoire : chaîne aléatoire de 24+ caractères (ex. : openssl rand -hex 32)
JWT_SECRET=
# Adresses e-mail administrateurs (séparées par des virgules)
ADMIN_EMAILS=
# Numéros (format +229...) qui deviennent administrateurs à leur première connexion
ADMIN_PHONES=+22900000000
# Origines autorisées pour le navigateur, séparées par des virgules
CORS_ORIGIN=https://votre-site.example
PORT=3000
# Sur Railway : monter un volume et pointer ici (ex. /data/mamacare.db)
DB_PATH=./mamacare.db
# SMS : "console" (affiche dans les logs, pour tester) ou "africastalking"
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER=
AT_SANDBOX=0
# Assistante IA (clé de la console Anthropic). Sans clé, l'application utilise des réponses préécrites.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# E-mail : "console" (logs) ou "brevo". EMAIL_FROM = adresse d'expéditeur validée chez Brevo.
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Mama Care
